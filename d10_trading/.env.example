# 複製為 d10_trading/.env 後在本機填入實值。d10_trading/.env 已列入 .gitignore，絕不提交。
# ⚠️ 不要把任何金鑰貼到對話、日誌或程式碼中。

# Shioaji API（於 https://www.sinotrade.com.tw/newweb/PythonAPIKey/ 建立）
SJ_API_KEY=your_api_key
SJ_SEC_KEY=your_secret_key

# 憑證（G2 真實下單起才需要；模擬環境不需要）
SJ_CA_PATH=C:/path/to/Sinopac.pfx
SJ_CA_PASSWD=your_ca_password

# Telegram 通知（@BotFather 建 bot；chat_id 可用 @userinfobot 查）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# G1 模擬期間的名目權益（模擬伺服器 margin() 回 0，僅模擬模式使用）
SIM_EQUITY=700000

# FinMind token（免費層可留空；VPS/雲端共享 IP 建議註冊免費 token 防節流）
FINMIND_TOKEN=

# healthchecks.io 心跳 URL（無人值守監控；留空 = 略過。deploy/README.md §8）
HEALTHCHECK_URL=

# 身分證字號——僅供 CA 憑證到期預警查詢（get_ca_expiretime）；留空 = 略過檢查
SJ_PERSON_ID=
